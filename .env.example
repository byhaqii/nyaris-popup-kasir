# Absolute path to the service account JSON, outside this project.
GOOGLE_APPLICATION_CREDENTIALS=
# Email of the Google account that owns both dedicated files.
POS_GOOGLE_OWNER=
# Set to 1 when serving through an HTTPS reverse proxy.
POS_HTTPS=0
# Optional absolute directory on persistent storage.
# POS_DATA_DIR=/srv/nyaris/data
# Server-only Supabase PostgreSQL pooler connection, with TLS.
SUPABASE_DB_URL=
# Public application URL used for payment-proof links in Google Sheets.
POS_PUBLIC_URL=
